// ==UserScript==
// @name         Realtor.ca Excel Copier
// @namespace    http://tampermonkey.net/
// @version      30.0
// @description  Copies Realtor.ca listing data formatted for Excel starting at Column B.
// @match        https://www.realtor.ca/real-estate/*
// @grant        GM_setClipboard
// ==/UserScript==

(function() {
    'use strict';

    window.addEventListener('load', () => {
        const btn = document.createElement('button');
        btn.id = 'tm-excel-copy-btn';
        btn.innerHTML = '📋 Copy for Excel';
        btn.style.position = 'fixed';
        btn.style.bottom = '20px';
        btn.style.right = '20px';
        btn.style.zIndex = '999999';
        btn.style.padding = '12px 20px';
        btn.style.backgroundColor = '#1F3864';
        btn.style.color = '#FFFFFF';
        btn.style.border = 'none';
        btn.style.borderRadius = '8px';
        btn.style.fontSize = '14px';
        btn.style.fontWeight = 'bold';
        btn.style.cursor = 'pointer';
        btn.style.boxShadow = '0 4px 10px rgba(0,0,0,0.3)';

        btn.addEventListener('click', extractAndCopy);
        document.body.appendChild(btn);
    });

    function clean(str) {
        if (!str) return '';
        return String(str)
            .replace(/[\t\r\n]+/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
    }

    function extractAndCopy() {
        let rawAddress = '';
        let region = '';
        let price = '';
        let sqft = '';
        let parking = '';
        let condoFees = '';
        let propTax = '';
        let buildingAmenities = '';
        let yearBuilt = '';
        let mlsNum = '';
        let bedrooms = '';
        let bathrooms = '';
        let ownershipType = '';
        let heatingCooling = '';
        let storage = '';

        const isGarbageText = (str) => {
            if (!str) return true;
            const lower = str.toLowerCase();
            return lower.includes('check out') || lower.includes('realtor.ca') || lower.includes('for sale');
        };

        const fullText = document.body.innerText;

        // 1. PRIMARY: Scan Listing Details (DOM Text) First
        const bAmenMatch = fullText.match(/(?:building\s*amenities|amenities\s*in\s*building|maintenance\s*includes)[:\s]*([^\n\r.]+)/i);
        if (bAmenMatch) {
            buildingAmenities = bAmenMatch[1].trim();
        } else {
            // Dictionary of target building amenities
            const commonAmenities = [
                { name: '24-hr Concierge', regex: /\b(?:24[- ]?hour|24\/7|24hr)?\s*concierge\b/i },
                { name: 'Gym', regex: /\b(?:gym|fitness|exercise\s*(?:centre|center|room))\b/i },
                { name: 'Guest Suites', regex: /\bguest\s*suite[s]?\b/i },
                { name: 'Resident Lounge', regex: /\b(?:resident\s*lounge|party\s*room|clubhouse|amenity\s*room|common\s*room)\b/i },
                { name: 'Pool', regex: /\b(?:pool|indoor\s*pool|outdoor\s*pool)\b/i },
                { name: 'Sauna', regex: /\b(?:sauna|steam\s*room|swirlpool|hot\s*tub)\b/i },
                { name: 'Visitor Parking', regex: /\bvisitor\s*parking\b/i },
                { name: 'Elevator', regex: /\belevator[s]?\b/i }
            ];

            const foundFeatures = [];

            // Targeted search: first check description/summary section, then full text
            const descSection = fullText.match(/(?:description|property\s*summary|about\s*this\s*property)[\s\S]{1,1500}/i);
            const searchText = descSection ? descSection[0] : fullText;

            commonAmenities.forEach(item => {
                if (item.regex.test(searchText) && !foundFeatures.includes(item.name)) {
                    foundFeatures.push(item.name);
                }
            });

            if (foundFeatures.length > 0) {
                buildingAmenities = foundFeatures.join(', ');
            }
        }

        // 2. Secondary Data Extraction (__NEXT_DATA__ JSON)
        const nextDataScript = document.getElementById('__NEXT_DATA__');
        if (nextDataScript) {
            try {
                const json = JSON.parse(nextDataScript.textContent);
                const pageProps = json?.props?.pageProps;
                const listing = pageProps?.initialData?.listing ||
                                pageProps?.listing ||
                                pageProps?.propertyDetails;

                if (listing) {
                    mlsNum = listing.MlsNumber || listing.Id || '';

                    // Price
                    if (listing.Property?.PriceUnformattedValue) {
                        price = String(listing.Property.PriceUnformattedValue);
                    } else if (listing.Property?.Price) {
                        price = listing.Property.Price.replace(/[^0-9]/g, '');
                    }

                    // Address & Region
                    if (listing.Property?.Address) {
                        const addrObj = listing.Property.Address;
                        rawAddress = addrObj.AddressText || addrObj.Address1 || addrObj.AddressLine1 || '';
                        region = addrObj.City || addrObj.CityName || '';
                    }

                    // SqFt
                    if (listing.Property?.Building?.SizeInterior) {
                        const sqMatch = listing.Property.Building.SizeInterior.match(/\d[\d,]*/);
                        if (sqMatch) sqft = sqMatch[0].replace(/,/g, '');
                    }

                    // Parking Extraction
                    const pTotal = listing.Property?.ParkingSpaceTotal || listing.ParkingSpaceTotal;
                    if (pTotal) {
                        parking = `${pTotal} spot(s)`;
                    } else {
                        const pArray = listing.Property?.Parking || listing.Property?.ParkingDetails || [];
                        if (Array.isArray(pArray) && pArray.length > 0) {
                            const validPark = pArray
                                .map(p => p.Name || p.Type || p.Spaces || '')
                                .filter(Boolean)
                                .filter(p => !/storage|locker/i.test(p));

                            if (validPark.length > 0) {
                                const totalSpots = validPark.reduce((acc, curr) => {
                                    const num = parseInt(curr, 10);
                                    return !isNaN(num) ? acc + num : acc;
                                }, 0);

                                parking = totalSpots > 0 ? `${totalSpots} spot(s)` : validPark.join(', ');
                            }
                        }
                    }

                    // FALLBACK: Use JSON amenities if DOM scan found nothing
                    if (!buildingAmenities) {
                        const bAmen = listing.Property?.Building?.Amenities || listing.Property?.BuildingAmenities;
                        if (bAmen) {
                            if (Array.isArray(bAmen)) {
                                buildingAmenities = bAmen.map(a => a.Name || a).join(', ');
                            } else if (typeof bAmen === 'string') {
                                buildingAmenities = bAmen;
                            }
                        }
                    }

                    // Year Built
                    if (listing.Property?.Building?.ConstructedDate) {
                        yearBuilt = String(listing.Property.Building.ConstructedDate);
                    }

                    // Details
                    if (listing.Property?.Bedroom) bedrooms = String(listing.Property.Bedroom);
                    if (listing.Property?.Bathroom) bathrooms = String(listing.Property.Bathroom);
                    if (listing.Property?.OwnershipType) ownershipType = listing.Property.OwnershipType;
                    if (listing.Property?.HeatingType) heatingCooling = listing.Property.HeatingType;
                }
            } catch (e) {
                console.error("JSON parse error:", e);
            }
        }

        // 3. Fallbacks for remaining fields
        if (!rawAddress || isGarbageText(rawAddress)) {
            const addrEl = document.querySelector('#propertyAddressVal, .propertyAddressVal, h1[class*="address"], .listing-address');
            if (addrEl && !isGarbageText(addrEl.innerText)) {
                rawAddress = addrEl.innerText;
            } else {
                const pathParts = window.location.pathname.split('/');
                const slug = pathParts[pathParts.length - 1] || pathParts[pathParts.length - 2];
                if (slug) rawAddress = slug.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
            }
        }

        if (!price) {
            const priceMatch = fullText.match(/\$\s*([1-9]\d{0,2}(?:,\d{3})+)/);
            if (priceMatch) price = priceMatch[1].replace(/,/g, '');
        }

        if (!sqft) {
            const sqftMatch = fullText.match(/(\d[\d,]*)\s*(?:sqft|sq\.\s*ft\.|square\s*feet)/i);
            if (sqftMatch) sqft = sqftMatch[1].replace(/,/g, '');
        }

        if (!parking) {
            const parkLabelMatch = fullText.match(/(?:parking|garage|underground|parking\s*spaces)[:\s]*(\d+)/i) ||
                                   fullText.match(/(?:underground|garage|covered|assigned|paved)\s*[\n\r\s]*(\d+)/i) ||
                                   fullText.match(/(\d+)\s*(?:underground|garage|covered|assigned|paved)\s*(?:spot|space|parking)?/i);

            if (parkLabelMatch) {
                const count = parkLabelMatch[1] || parkLabelMatch[2];
                if (count && !isNaN(parseInt(count, 10))) {
                    parking = `${count} spot(s)`;
                }
            }
        }
        if (parking) {
            parking = parking.replace(/,?\s*(?:storage|locker|and\s*storage).*$/i, '').trim();
        }

        if (!yearBuilt) {
            const yearMatch = fullText.match(/(?:built\s*in|year\s*built|constructed)[:\s]*(\d{4})/i);
            if (yearMatch) yearBuilt = yearMatch[1];
        }

        if (!mlsNum) {
            const mlsMatch = fullText.match(/MLS®\s*Number:\s*([A-Z0-9]+)/i);
            if (mlsMatch) mlsNum = mlsMatch[1];
        }

        if (!condoFees) {
            const feeMatch = fullText.match(/(?:maintenance|condo|strata)\s*fee[s]?[:\s]*\$?\s*([\d,.]+)/i);
            if (feeMatch) condoFees = Math.round(parseFloat(feeMatch[1].replace(/,/g, ''))).toString();
        }

        if (!propTax) {
            const taxMatch = fullText.match(/(?:property\s*tax|annual\s*tax|taxes)[:\s]*\$?\s*([\d,.]+)/i);
            if (taxMatch) propTax = Math.round(parseFloat(taxMatch[1].replace(/,/g, ''))).toString();
        }

        if (!bedrooms) {
            const bedMatch = fullText.match(/(\d+\s*(?:\+\s*\d+)?)\s*Bedrooms?/i);
            if (bedMatch) bedrooms = bedMatch[1];
        }
        if (!bathrooms) {
            const bathMatch = fullText.match(/(\d+)\s*Bathrooms?/i);
            if (bathMatch) bathrooms = bathMatch[1];
        }

        if (!ownershipType) {
            const ownMatch = fullText.match(/(Freehold Strata|Strata|Leasehold|Co-operative)/i);
            if (ownMatch) ownershipType = ownMatch[1];
        }
        if (!heatingCooling) {
            const acMatch = fullText.match(/(Air Conditioning|Central A\/C|Heat Pump|Baseboard|Electric)/i);
            if (acMatch) heatingCooling = acMatch[1];
        }

        if (/storage|locker|in-suite storage/i.test(fullText)) {
            storage = 'Yes';
        }

        if (!region || isGarbageText(region)) {
            if (rawAddress && rawAddress.includes(',')) {
                const parts = rawAddress.split(',');
                if (parts.length >= 2) region = parts[1].trim();
            } else {
                const urlParts = window.location.pathname.split('-');
                if (urlParts.length > 0) {
                    const lastWord = urlParts[urlParts.length - 1];
                    if (isNaN(lastWord)) {
                        region = lastWord.charAt(0).toUpperCase() + lastWord.slice(1);
                    }
                }
            }
        }
        region = region.replace(/\b(ON|BC|AB|QC|MB|SK|NS|NB|NL|PE|NT|YT|NU)\b.*/i, '').trim();

        const url = window.location.href;

        // Standard 16-column row output (Columns B through Q)
        const rowData = [
            clean(region),             // Column B
            clean(price),              // Column C
            clean(sqft),               // Column D
            clean(rawAddress),         // Column E
            clean(parking),            // Column F
            clean(condoFees),          // Column G
            clean(propTax),            // Column H
            clean(url),                // Column I
            clean(buildingAmenities),  // Column J: Building Amenities
            clean(yearBuilt),          // Column K
            clean(mlsNum),             // Column L
            clean(bedrooms),           // Column M
            clean(bathrooms),          // Column N
            clean(ownershipType),      // Column O
            clean(heatingCooling),     // Column P
            clean(storage)             // Column Q
        ];

        GM_setClipboard(rowData.join('\t'));

        const btn = document.getElementById('tm-excel-copy-btn');
        if (btn) {
            btn.innerHTML = '✅ Copied!';
            btn.style.backgroundColor = '#2e7d32';
            setTimeout(() => {
                btn.innerHTML = '📋 Copy for Excel';
                btn.style.backgroundColor = '#1F3864';
            }, 2000);
        }
    }
})();
